<Window x:Class="BrowserUse.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Browser Use Settings"
        Width="540"
        Height="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6F8"
        FontFamily="Segoe UI">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style TargetType="TextBlock" x:Key="RowLabel">
            <Setter Property="Width" Value="120" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Margin" Value="0,3,14,0" />
        </Style>
        <Style TargetType="TextBlock" x:Key="HintText">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style TargetType="Button" x:Key="StdBtn">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Window.Resources>

    <TabControl Margin="12" Background="#FFFFFF" Padding="18">
        <!-- General -->
        <TabItem Header="General">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- In-process hub -->
                    <DockPanel Margin="0,0,0,16">
                        <TextBlock DockPanel.Dock="Left" Text="In-process hub:" Style="{StaticResource RowLabel}" />
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{Binding PhaseBrush}" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding HubSummary}" FontSize="12.5" Foreground="#334155" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Restart" Style="{StaticResource StdBtn}" Click="RestartHub_Click" />
                                <TextBox Text="{Binding HubUrl, Mode=OneWay}"
                                         IsReadOnly="True"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         FontFamily="Consolas"
                                         FontSize="12"
                                         Foreground="#475569"
                                         VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="The hub runs inside Browser Use on the loopback interface. Opening the app starts it; quitting the app stops it. MCP clients and the CLI connect to it over WebSocket."
                                       Style="{StaticResource HintText}" />
                            <TextBlock Text="{Binding Notice}"
                                       Visibility="{Binding ShowNoticeBanner, Converter={StaticResource BoolToVis}}"
                                       Style="{StaticResource HintText}" />
                        </StackPanel>
                    </DockPanel>

                    <!-- Hub port -->
                    <DockPanel Margin="0,0,0,16">
                        <TextBlock DockPanel.Dock="Left" Text="Hub port:" Style="{StaticResource RowLabel}" />
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="PortTextBox" Width="90" Padding="6,4" Margin="0,0,8,0" />
                                <Button x:Name="ApplyPortButton" Content="Apply &amp; Restart" Style="{StaticResource StdBtn}" Click="ApplyPort_Click" />
                            </StackPanel>
                            <TextBlock Text="MCP clients use this port too. The default is 19455. Changing it restarts the in-process hub; Zen's orange_bridge.url must match it."
                                       Style="{StaticResource HintText}" />
                        </StackPanel>
                    </DockPanel>

                    <!-- Tray menu -->
                    <DockPanel Margin="0,0,0,16">
                        <TextBlock DockPanel.Dock="Left" Text="System tray:" Style="{StaticResource RowLabel}" />
                        <StackPanel>
                            <CheckBox x:Name="ShowTabsCheckBox"
                                      Content="Show open tabs in the tray menu"
                                      IsChecked="{Binding ShowTabsInMenu, Mode=TwoWay}" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Menu tab limit:" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox x:Name="TabLimitCombo" Width="70" SelectionChanged="TabLimitCombo_SelectionChanged" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>

                    <!-- Refresh -->
                    <DockPanel Margin="0,0,0,16">
                        <TextBlock DockPanel.Dock="Left" Text="Refresh:" Style="{StaticResource RowLabel}" />
                        <ComboBox x:Name="RefreshCombo" Width="130" HorizontalAlignment="Left" SelectionChanged="RefreshCombo_SelectionChanged">
                            <ComboBoxItem Content="1 second" Tag="1" />
                            <ComboBoxItem Content="2 seconds" Tag="2" />
                            <ComboBoxItem Content="5 seconds" Tag="5" />
                            <ComboBoxItem Content="10 seconds" Tag="10" />
                        </ComboBox>
                    </DockPanel>

                    <!-- Login -->
                    <DockPanel Margin="0,0,0,16">
                        <TextBlock DockPanel.Dock="Left" Text="Login:" Style="{StaticResource RowLabel}" />
                        <StackPanel>
                            <CheckBox x:Name="LaunchAtLoginCheckBox"
                                      Content="Start Browser Use at login"
                                      Click="LaunchAtLogin_Click" />
                            <TextBlock x:Name="LaunchAtLoginErrorText"
                                       Visibility="Collapsed"
                                       FontSize="11.5"
                                       Foreground="#D97706"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                            <TextBlock Text="Starting Browser Use at login also starts the in-process hub."
                                       Style="{StaticResource HintText}" />
                        </StackPanel>
                    </DockPanel>

                    <!-- Reset -->
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="Reset:" Style="{StaticResource RowLabel}" />
                        <Button Content="Reset Preferences" HorizontalAlignment="Left" Style="{StaticResource StdBtn}" Click="Reset_Click" />
                    </DockPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- Connection -->
        <TabItem Header="Connection">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <DockPanel Margin="0,0,0,16">
                        <TextBlock DockPanel.Dock="Left" Text="Hub:" Style="{StaticResource RowLabel}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Address" Foreground="#64748B" Margin="0,2" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding HubUrl, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" FontFamily="Consolas" Foreground="#475569" Margin="0,2" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="State" Foreground="#64748B" Margin="0,2" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding HubSummary}" Foreground="#475569" Margin="0,2" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Extension" Foreground="#64748B" Margin="0,2" />
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ExtensionStatusValue" Foreground="#475569" Margin="0,2" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Version" Foreground="#64748B" Margin="0,2" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ExtensionVersion}" Foreground="#475569" Margin="0,2" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Protocol" Foreground="#64748B" Margin="0,2" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ProtocolVersion}" Foreground="#475569" Margin="0,2" />

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Peers" Foreground="#64748B" Margin="0,2" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Peers}" Foreground="#475569" Margin="0,2" />

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Uptime" Foreground="#64748B" Margin="0,2" />
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding UptimeText}" Foreground="#475569" Margin="0,2" />
                        </Grid>
                    </DockPanel>

                    <DockPanel Margin="0,0,0,16">
                        <TextBlock DockPanel.Dock="Left" Text="Shared secret:" Style="{StaticResource RowLabel}" />
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="SecretTextBox"
                                         Grid.Column="0"
                                         IsReadOnly="True"
                                         FontFamily="Consolas"
                                         Padding="8,5"
                                         Background="#F8FAFC"
                                         BorderBrush="#E2E8F0"
                                         Text="••••••••••••••••••••••••" />
                                <Button x:Name="RevealSecretButton"
                                        Grid.Column="1"
                                        Content="Reveal"
                                        Padding="10,5"
                                        Margin="8,0,0,0"
                                        Click="RevealSecret_Click" />
                            </Grid>

                            <TextBlock x:Name="SecretPathHint" Style="{StaticResource HintText}" />

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Copy Secret" Style="{StaticResource StdBtn}" Click="CopySecret_Click" />
                                <Button Content="Copy Zen Setup Command" Style="{StaticResource StdBtn}" Click="CopySetupCommand_Click" />
                                <Button Content="Open Extension Folder" Style="{StaticResource StdBtn}" Click="OpenExtension_Click" />
                            </StackPanel>

                            <TextBlock Text="Load extension\manifest.json in Zen (about:debugging → This Zen → Load Temporary Add-on…), then click the Gecko Orange toolbar icon (or Inspect → Console) and paste the secret or setup command."
                                       Style="{StaticResource HintText}" />
                        </StackPanel>
                    </DockPanel>

                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="Connection:" Style="{StaticResource RowLabel}" />
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Restart Hub" Style="{StaticResource StdBtn}" Click="RestartHub_Click" />
                                <Button Content="Refresh Now" Style="{StaticResource StdBtn}" Click="Refresh_Click" />
                            </StackPanel>
                            <TextBlock Text="{Binding LastError}"
                                       Visibility="{Binding ShowErrorBanner, Converter={StaticResource BoolToVis}}"
                                       FontSize="11.5"
                                       Foreground="#D97706"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- About -->
        <TabItem Header="About">
            <StackPanel>
                <DockPanel Margin="0,0,0,16">
                    <TextBlock DockPanel.Dock="Left" Text="Browser Use:" Style="{StaticResource RowLabel}" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Resources/AppIcon.ico" Width="40" Height="40" Margin="0,0,12,0" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Browser Use" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="Version 0.1.0" FontSize="12" Foreground="#64748B" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>

                <DockPanel Margin="0,0,0,16">
                    <TextBlock DockPanel.Dock="Left" Text="Hub:" Style="{StaticResource RowLabel}" />
                    <StackPanel>
                        <TextBlock Text="{Binding HubUrl}" FontFamily="Consolas" FontSize="12" Foreground="#475569" />
                        <TextBlock Text="{Binding HubSummary}" FontSize="12" Foreground="#64748B" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding UptimeText, StringFormat=Uptime: {0}}" FontSize="12" Foreground="#64748B" Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>

                <DockPanel Margin="0,0,0,16">
                    <TextBlock DockPanel.Dock="Left" Text="Resources:" Style="{StaticResource RowLabel}" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="README" Style="{StaticResource StdBtn}" Click="OpenReadme_Click" />
                        <Button Content="Reveal Hub Logs" Style="{StaticResource StdBtn}" Click="RevealLogs_Click" />
                        <Button Content="Secret Location" Style="{StaticResource StdBtn}" Click="RevealSecretLocation_Click" />
                    </StackPanel>
                </DockPanel>

                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="Behavior:" Style="{StaticResource RowLabel}" />
                    <TextBlock Text="The hub runs inside this app, so MCP clients and terminal commands share one browser connection while Browser Use is open. Quitting the app stops the hub."
                               Style="{StaticResource HintText}"
                               Margin="0" />
                </DockPanel>
            </StackPanel>
        </TabItem>
    </TabControl>
</Window>
