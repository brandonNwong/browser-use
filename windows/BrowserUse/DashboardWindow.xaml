<Window x:Class="BrowserUse.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Browser Use"
        Width="820"
        Height="580"
        MinWidth="720"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6F8"
        FontFamily="Segoe UI">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style TargetType="Button" x:Key="ToolbarBtn">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D4D7DD" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="Button" x:Key="PrimaryBtn">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Background" Value="#FF6B1A" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Toolbar -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="16,10">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Refresh" Style="{StaticResource ToolbarBtn}" Click="Refresh_Click" />
                    <Button Content="Restart Hub" Style="{StaticResource ToolbarBtn}" Click="RestartHub_Click" />
                    <Button Content="Settings…" Style="{StaticResource ToolbarBtn}" Click="Settings_Click" />
                    <Button Content="More ▾" Style="{StaticResource ToolbarBtn}" Click="More_Click">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="MoreMenu">
                                <MenuItem Header="Settings…" Click="Settings_Click" />
                                <Separator />
                                <MenuItem Header="Copy Shared Secret" Click="CopySecret_Click" />
                                <MenuItem Header="Copy Zen Setup Command" Click="CopySetupCommand_Click" />
                                <MenuItem Header="Reveal Gecko Orange Extension" Click="OpenExtension_Click" />
                                <Separator />
                                <MenuItem Header="Reveal Hub Logs" Click="RevealLogs_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Search tabs:" VerticalAlignment="Center" Foreground="#64748B" Margin="0,0,8,0" />
                    <TextBox x:Name="SearchBox"
                             Width="220"
                             Padding="8,5"
                             BorderBrush="#D4D7DD"
                             TextChanged="SearchBox_TextChanged" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Status Card -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="20">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Phase Icon Badge -->
                    <Border Grid.Column="0"
                            Width="56"
                            Height="56"
                            CornerRadius="12"
                            Background="{Binding PhaseTintBackground}"
                            Margin="0,0,16,0">
                        <TextBlock Text="●"
                                   FontSize="22"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding PhaseBrush}" />
                    </Border>

                    <!-- Title + Endpoint + Subtitle -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <TextBlock Text="{Binding PhaseTitle}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#0F172A" />
                            <Border CornerRadius="10"
                                    Background="{Binding PhaseTintBackground}"
                                    Padding="8,2"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding StatusPill}"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{Binding PhaseBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBox Text="{Binding HubUrl, Mode=OneWay}"
                                 IsReadOnly="True"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontFamily="Consolas"
                                 FontSize="12.5"
                                 Foreground="#475569"
                                 Padding="0"
                                 Margin="0,0,0,2" />
                        <TextBlock Text="{Binding ExtensionSubtitle}"
                                   FontSize="11.5"
                                   Foreground="#64748B" />
                    </StackPanel>

                    <!-- Metrics -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Margin="18,0,0,0" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding TabCount}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="#0F172A" />
                            <TextBlock Text="Tabs" FontSize="11" HorizontalAlignment="Right" Foreground="#64748B" />
                        </StackPanel>
                        <StackPanel Margin="22,0,0,0" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding Peers}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="#0F172A" />
                            <TextBlock Text="Peers" FontSize="11" HorizontalAlignment="Right" Foreground="#64748B" />
                        </StackPanel>
                        <StackPanel Margin="22,0,0,0" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding UptimeText}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="#0F172A" />
                            <TextBlock Text="Uptime" FontSize="11" HorizontalAlignment="Right" Foreground="#64748B" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Notice / Error Banners -->
                <TextBlock Text="{Binding Notice}"
                           Visibility="{Binding ShowNoticeBanner, Converter={StaticResource BoolToVis}}"
                           Margin="0,10,0,0"
                           FontSize="12"
                           Foreground="#475569"
                           TextWrapping="Wrap" />

                <TextBlock Text="{Binding LastError}"
                           Visibility="{Binding ShowErrorBanner, Converter={StaticResource BoolToVis}}"
                           Margin="0,8,0,0"
                           FontSize="12"
                           Foreground="#D97706"
                           TextWrapping="Wrap" />

                <!-- Setup Card when extension is disconnected -->
                <Border Visibility="{Binding ShowSetupCard, Converter={StaticResource BoolToVis}}"
                        Margin="0,14,0,0"
                        Padding="14"
                        CornerRadius="8"
                        Background="#FFF7ED"
                        BorderBrush="#FED7AA"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Finish connecting Zen" FontWeight="SemiBold" FontSize="13.5" Foreground="#9A3412" />
                        <TextBlock Text="1. In Zen open about:debugging → This Zen → Load Temporary Add-on… and select extension\manifest.json.&#10;2. Click the Gecko Orange icon in Zen's toolbar (or open Inspect → Console), paste your setup command/secret, and connect."
                                   Margin="0,4,0,10"
                                   FontSize="12"
                                   Foreground="#7C2D12"
                                   TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Copy Setup Command" Style="{StaticResource PrimaryBtn}" Margin="0,0,8,0" Click="CopySetupCommand_Click" />
                            <Button Content="Open Extension Folder" Style="{StaticResource ToolbarBtn}" Click="OpenExtension_Click" />
                            <Button Content="Copy Shared Secret" Style="{StaticResource ToolbarBtn}" Click="CopySecret_Click" />
                            <Button Content="Reveal Hub Logs" Style="{StaticResource ToolbarBtn}" Click="RevealLogs_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Open Tabs Section -->
        <Grid Grid.Row="2" Background="#FFFFFF">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="20,12">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Open Tabs" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" />
                    <Border Background="#F1F5F9" CornerRadius="8" Padding="7,2" Margin="8,0,0,0">
                        <TextBlock Text="{Binding TabCount}" FontSize="11.5" FontWeight="Medium" Foreground="#475569" />
                    </Border>
                </StackPanel>
                <Button DockPanel.Dock="Right" Content="Refresh Tabs" Style="{StaticResource ToolbarBtn}" Click="Refresh_Click" />
            </DockPanel>

            <ListBox x:Name="TabsListBox"
                     Grid.Row="1"
                     BorderThickness="0"
                     Padding="12,0,12,12"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="10,8" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Switch to Tab" Click="SwitchTabMenu_Click" Tag="{Binding}" />
                                    <Separator />
                                    <MenuItem Header="Copy URL" Click="CopyTabUrl_Click" Tag="{Binding}" />
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Ellipse Grid.Column="0" Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#CBD5E1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Fill" Value="#FF6B1A" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DisplayTitle}" FontSize="13" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Border Background="#FFF7ED" CornerRadius="6" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="ACTIVE" FontSize="9" FontWeight="Bold" Foreground="#EA580C" />
                                        </Border>
                                        <TextBlock Text="📌" FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Url}" FontSize="11.5" Foreground="#64748B" TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <Button Grid.Column="2"
                                        Content="Switch"
                                        Tag="{Binding}"
                                        Click="SwitchTabButton_Click"
                                        Padding="10,4"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Empty state overlay -->
            <StackPanel x:Name="EmptyStatePanel"
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False">
                <TextBlock x:Name="EmptyStateTitle"
                           Text="No browser connection"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#334155"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="EmptyStateSubtitle"
                           Text="Connect the Gecko Orange extension to list tabs here."
                           FontSize="12.5"
                           Foreground="#64748B"
                           Margin="0,4,0,0"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
