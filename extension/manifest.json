{
  "manifest_version": 2,
  "name": "Gecko Orange",
  "version": "3.0.0",
  "description": "Localhost WebSocket bridge connecting Firefox and Zen Browser to Browser Use.",
  "browser_specific_settings": {
    "gecko": {
      "id": "gecko-orange@browser-use.local",
      "strict_min_version": "109.0"
    }
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "browser_action": {
    "default_title": "Gecko Orange (Browser Use)",
    "default_icon": "icon.svg",
    "default_popup": "popup.html"
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": true
  },
  "permissions": [
    "<all_urls>",
    "tabs",
    "activeTab",
    "storage",
    "webRequest",
    "webRequestBlocking",
    "webNavigation"
  ]
}
